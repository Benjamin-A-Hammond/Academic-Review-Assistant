# =============================================================================
# Academic Review Assistant — environment variables
#
# Intended use: authors' pre-submission self-check & simulated peer review
# on manuscripts they own or are authorized to process.
#
# NOT intended for formal reviewers: do not upload others' unpublished or
# confidential manuscripts (e.g. blind-review assignments) to MinerU/LLM APIs.
# =============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# =============================================================================

# -----------------------------------------------------------------------------
# MinerU cloud API (required for PDF → Markdown)
# Token: https://mineru.net/apiManage/token
# -----------------------------------------------------------------------------
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4
# Model: vlm | pipeline | html
MINERU_MODEL=vlm
# Document language hint: ch | en | ...
MINERU_LANG=en
# API request timeout (seconds)
MINERU_TIMEOUT=600
MINERU_OCR=1
MINERU_FORMULA=1
MINERU_TABLE=1

# -----------------------------------------------------------------------------
# Fast model — task-based section bindings (structure_sections → section_map.json)
# Example: DeepSeek Flash
# -----------------------------------------------------------------------------
FAST_API_KEY=
FAST_BASE_URL=https://api.deepseek.com/v1
FAST_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# Professional model (primary) — contribution, experiment, review
# Reads section-focused excerpts when section_map.json exists
# OpenAI-compatible API must use .../v1 (code auto-appends if missing)
# -----------------------------------------------------------------------------
PRO_API_KEY=
PRO_BASE_URL=https://api.deepseek.com/v1
PRO_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Second professional model — dual-expert merge (optional)
# When PRO2_* is set, Pro+Pro2 reviews merge into one review_draft.md
# Use --no-compare for single-expert mode
# -----------------------------------------------------------------------------
PRO2_API_KEY=
PRO2_BASE_URL=https://api.deepseek.com/v1
PRO2_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# Output language for review drafts
# zh = review_draft.md (en) + review_draft_zh.md (zh)
# en = review_draft.md only
# -----------------------------------------------------------------------------
OUTPUT_LANG=zh

# -----------------------------------------------------------------------------
# Development
# Set LLM_STUB=1 to return placeholder text when API keys are not configured
# -----------------------------------------------------------------------------
LLM_STUB=0
